{
  "manifest_version": 2,
  "name": "Zotero Close to Tray",
  "version": "1.0.3",
  "author": "p1aintiff",
  "description": "点击关闭按钮时将 Zotero 隐藏到 Windows 系统托盘。",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "applications": {
    "zotero": {
      "id": "close-to-tray@zotero-exit.local",
      "update_url": "https://raw.githubusercontent.com/p1aintiff/zotero-close-to-tray/main/updates.json",
      "strict_min_version": "10.0",
      "strict_max_version": "10.0.*"
    }
  }
}
